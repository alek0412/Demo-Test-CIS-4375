# Server
PORT=3000

# Database (AWS RDS)
DB_HOST=reservation-capstone-db.czltypivanye.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=reservation_db
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# Optional: full MySQL URL (overrides individual DB_* vars if set)
# DATABASE_URL=mysql://user:password@reservation-capstone-db.czltypivanye.us-east-1.rds.amazonaws.com:3306/reservation_db

# Admin (optional; defaults in server.js)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=Admin123!

# Customer login (optional; defaults in server.js for local dev)
# CUSTOMER_EMAIL=your@email.com
# CUSTOMER_PASSWORD=your_password

# Waiver registration: default membership_status foreign key (see membership table). Use 2 for adult if unsure.
# DEFAULT_MEMBERSHIP_STATUS=2

# Password reset — required for correct links when hosted on AWS (not localhost).
# Set APP_BASE_URL to the URL users open in the browser, e.g. http://YOUR_ELASTIC_IP:3000 or https://yourdomain.com
# Without SMTP_* below, reset links are only logged on the server (fine for dev on EC2; use SES for real mail).
# APP_BASE_URL=http://3.211.8.41:3000
# Amazon SES SMTP (or other provider): host is typically email-smtp.us-east-1.amazonaws.com in us-east-1
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
