# Copy this file to .env and fill in real values. Never commit .env.
#   cp .env.example .env

# Server
PORT=3000

# MySQL (RDS) — required for Admin “View data” / Customers and customer accounts
DB_HOST=reservation-capstone-db.czltypivanye.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=reservation_db
DB_USER=HBC_DB_Admin
DB_PASSWORD=

# Use HBC_Reservation_System instead of reservation_db if your schema lives there:
# DB_NAME=HBC_Reservation_System

# Optional: single URL instead of host/port/name (overrides DB_* if set)
# DATABASE_URL=mysql://user:pass@host:3306/dbname

# Admin dashboard login (change in production)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# Customer dev defaults (override in production)
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=
# CUSTOMER_SESSION_SECRET=   # optional; random default if unset

# Password reset emails (optional; without SMTP, reset may log to console only)
# APP_BASE_URL=https://your-ec2-or-domain:3000
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# New customer default membership status (see lib/customerPassword.js)
# DEFAULT_MEMBERSHIP_STATUS=2
